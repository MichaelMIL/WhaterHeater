# Copy to .env and fill in. Lines are KEY=VALUE, # starts a comment.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# Relay base URL - device IP or mDNS name (resolved once and cached)
DEVICE_URL=http://192.168.50.207

# Comma-separated chat IDs allowed to use the bot (empty = anyone!).
# Send /chatid to the bot to find yours.
ALLOWED_CHAT_IDS=

# Chat that receives alerts & the daily summary (default: first allowed chat)
ALERT_CHAT_ID=

# Alert if the heater is on continuously for this many hours (0 = off)
ALERT_ON_HOURS=3

# Local time for the daily usage summary, HH:MM (empty = off)
SUMMARY_TIME=21:00

# Local web panel (same buttons & settings as the bot). Port 0 = disabled.
# 0.0.0.0 = reachable from the whole LAN; 127.0.0.1 = this PC only.
WEB_PORT=4245
WEB_HOST=0.0.0.0
